<!-- Argentas SyncEngine facade: phase 2, behavior-preserving extraction -->
<script>
/*
 * SyncEngine facade
 * -----------------
 * This is intentionally a compatibility layer for the first extraction step.
 * It exposes the existing synchronization operations behind one stable
 * namespace without changing message formats, localStorage keys, timers,
 * retries, ACKs, reconciliation, or Supabase transport behavior.
 *
 * Later steps can move the implementations behind this facade one operation
 * at a time. Keeping the facade thin is deliberate: this commit must be
 * behavior-preserving.
 */
window.ArgentasSyncEngine = window.ArgentasSyncEngine || (function(){
  'use strict';

  function call(name,args){
    if(typeof window[name] !== 'function'){
      throw new Error('ArgentasSyncEngine: operación no disponible: '+name);
    }
    return window[name].apply(window,args||[]);
  }

  return Object.freeze({
    sync:function(){ return call('sync',arguments); },
    queueComandaStatus:function(order){ return call('queueComandaStatus',[order]); },
    sendVenderDirect:function(type,payload){ return call('sendVenderDirect',[type,payload]); },
    retryVenderDirect:function(){ return call('retryVenderDirect',arguments); },
    flushComandaStatus:function(){ return call('flushComandaStatus',arguments); },
    recover:function(){
      if(window.ArgentasSupabaseTransport &&
         typeof window.ArgentasSupabaseTransport.recover==='function'){
        return window.ArgentasSupabaseTransport.recover();
      }
      return call('recoverRecent',arguments);
    },
    connect:function(){
      if(window.ArgentasSupabaseTransport &&
         typeof window.ArgentasSupabaseTransport.connect==='function'){
        return window.ArgentasSupabaseTransport.connect();
      }
      return call('connect',arguments);
    },
    transport:function(){
      return window.ArgentasSupabaseTransport || null;
    },
    receive:function(raw){
      if(typeof window.onSupabaseMessage==='function'){
        return window.onSupabaseMessage(raw);
      }
      throw new Error('ArgentasSyncEngine: receptor Supabase no disponible');
    }
  });
})();
</script>
